{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build project",
            "command": "/usr/bin/clang++",
            "args": [
                "-std=c++20",
                "-stdlib=libc++",
                "-Wall",
                "-Wextra",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/*.cpp",
                "${workspaceFolder}/src/*.cpp",
                "${workspaceFolder}/src/midi/*.cpp",
                "-o",
                "${workspaceFolder}/main"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiler: /usr/bin/clang++"
        }
    ]
}